# Build settings for the Al-Mudarris copy (no secrets here). Used by scripts/build-almudarris.sh and, later,
# as the Environment variables of a Cloudflare Pages project for the copy.
SITE_VARIANT=almudarris
NEXT_PUBLIC_SITE_ID=almudarris-site
# "" = the copy's own worker serves both the website and its API on the same address.
# For a separate Pages project use: https://almudarris-session.shaiqmuhammad.workers.dev
NEXT_PUBLIC_ASSESSMENT_API_URL=
NEXT_PUBLIC_DEFAULT_HOST=almudarris-session.shaiqmuhammad.workers.dev
NEXT_PUBLIC_SITE_ADDRESSES=almudarris-session.shaiqmuhammad.workers.dev,school.almudarris.com,www.almudarris.com,almudarris.com
NEXT_PUBLIC_SITE_NAME=Al-Mudarris
NEXT_PUBLIC_SITE_NAME_AR=المدرّس
NEXT_PUBLIC_SITE_SHORT_NAME=Al-Mudarris
NEXT_PUBLIC_SITE_DOMAIN=almudarris.com
NEXT_PUBLIC_SITE_TAGLINE=A calm learning home for students
NEXT_PUBLIC_SITE_EMAIL=contact@almudarris.com
