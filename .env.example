# Public URL of the Login Portal (Gibbon or equivalent)
# Falls back to http://localhost:8080 when unset
NEXT_PUBLIC_PORTAL_URL=http://localhost:8080

# Admin CMS password for /admin (baked in at build time — static export has no server secrets)
# Login URL: https://www.shaiqmuhammad.com/admin/login
# Change this before deploying. Do not commit real production secrets.
NEXT_PUBLIC_ADMIN_PASSWORD=ShaiqAdmin2026!

# Optional absolute site URL (used only if needed for absolute fetches)
# NEXT_PUBLIC_SITE_URL=https://www.shaiqmuhammad.com

# Contact form (optional). Formspree example: https://formspree.io/f/your-id
# When unset, /contact uses mailto: fallback to info@shaiqmuhammad.com
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Free live chat — Tawk.to (https://www.tawk.to). Paste IDs from Admin → Channels → Chat Widget.
# Script: https://embed.tawk.to/PROPERTY_ID/WIDGET_ID
# When unset, a discreet "Chat coming soon" + Contact link is shown.
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=
